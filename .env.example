# Copy to .env.local for dev, and set the same in Vercel > Settings > Environment Variables.
# Frontend (Vite) — PUBLIC, shipped to browser:
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
# 1 = force mock checkout (no money). 0 = use real Checkout.js when KEY_ID is set.
VITE_RAZORPAY_MOCK=1

# Backend (Vercel Serverless) — SECRET, never prefix with VITE_:
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID=plan_XXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX

# Pro persistence (production). Without these, the API uses in-memory
# storage (dev only — Pro won't survive restarts or restore by email).
# 1. https://supabase.com -> New project -> SQL Editor -> paste supabase.sql -> Run
# 2. Project Settings > API: copy URL + service_role key (server-only!)
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# How to get these (Test Mode):
# 1. https://dashboard.razorpay.com -> Test Mode toggle ON
# 2. Settings > API Keys > Generate Test Key (KEY_ID + KEY_SECRET)
# 3. Subscriptions > Create Plan: Rs 99/month, billing interval monthly (PLAN_ID)
# 4. Settings > Webhooks > Add: https://<your-app>.vercel.app/api/webhook
#    events: subscription.authenticated, subscription.activated, subscription.charged,
#            subscription.cancelled, payment.failed (WEBHOOK_SECRET)
